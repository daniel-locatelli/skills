#!/bin/sh
# Refuse to commit private-infrastructure identifiers to this PUBLIC repo.
# Private skills belong in gitlab/daniellocatelli/skills-private.
#
# The patterns are base64-encoded so this public file does not itself publish
# the identifiers it exists to keep out. This is obfuscation, not secrecy:
# decode with: grep -o 'PATTERNS="[^"]*"' .githooks/pre-commit | cut -d\" -f2 | base64 -d
PATTERNS="MTAwXC45NFwuMThcLjd8ZG5sQHwvc3J2L2xpYnJhcmlhbg=="
if git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' \
   | grep -nE "$(printf '%s' "$PATTERNS" | base64 -d)"; then
  echo ""
  echo "REFUSED: the staged diff contains a private identifier."
  echo "This repo is public. Move the content to skills-private."
  exit 1
fi
exit 0
